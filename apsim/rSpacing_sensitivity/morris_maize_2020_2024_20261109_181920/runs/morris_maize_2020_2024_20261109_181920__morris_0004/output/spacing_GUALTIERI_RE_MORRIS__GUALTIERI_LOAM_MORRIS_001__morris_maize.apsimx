},
            {
  "$type": "Models.Manager, Models",
  "Name": "Fertilise_Maize_D35_1",
  "CodeArray": [
    "using Models.Core;",
    "using System;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Fertiliser Fertiliser;",
    "        [Link] private Summary Summary;",
    "        [Link(ByName = true)] private Models.PMF.Plant Maize;",
    "",
    "        [Description(\"Days after sowing\")]",
    "        public int DAS { get; set; }",
    "",
    "        [Description(\"Amount of N (kg/ha)\")]",
    "        public double Amount { get; set; }",
    "",
    "        [Description(\"Fertiliser type\")]",
    "        public string FertType { get; set; }",
    "",
    "        private DateTime _sowDate = DateTime.MinValue;",
    "        private bool _applied = false;",
    "",
    "        [EventSubscribe(\"Sowing\")]",
    "        private void OnSowing(object sender, EventArgs e)",
    "        {",
    "            if (sender == Maize)",
    "            {",
    "                _sowDate = Clock.Today;",
    "                _applied = false;",
    "            }",
    "        }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (!_applied && _sowDate != DateTime.MinValue && Maize.IsAlive)",
    "            {",
    "                int das = (Clock.Today - _sowDate).Days;",
    "                if (das >= DAS && Amount > 0)",
    "                {",
    "                    Fertiliser.Apply(amount: Amount, type: FertType);",
    "                    Summary.WriteMessage(this, $\"N copertura Maize: {Amount:F1} kg N/ha a {das} DAS\", MessageType.Diagnostic);",
    "                    _applied = true;",
    "                }",
    "            }",
    "            // Reset quando la coltura è morta/raccolta",
    "            if (!Maize.IsAlive) { _sowDate = DateTime.MinValue; _applied = false; }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
    {
      "Key": "DAS",
      "Value": "35"
    },
    {
      "Key": "Amount",
      "Value": "100.0"
    },
    {
      "Key": "FertType",
      "Value": "UreaN"
    }
  ],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Irrigate_Maize",
  "CodeArray": [
    "using Models.Core;",
    "using Models.Soils;",
    "using Models.Interfaces;",
    "using System;",
    "using System.Linq;",
    "using APSIM.Shared.Utilities;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Irrigation Irrigation;",
    "        [Link] private Summary Summary;",
    "        [Link] private Zone Zone;",
    "        [Link(ByName = true)] private Models.PMF.Plant Maize;",
    "",
    "        [Description(\"Soglia PAW/PAWC sotto cui irrigare (0-1)\")]",
    "        public double Threshold { get; set; }",
    "",
    "        [Description(\"Obiettivo di ricarica PAW/PAWC (0-1)\")]",
    "        public double Target { get; set; }",
    "",
    "        [Description(\"Dose massima per turno (mm)\")]",
    "        public double MaxMm { get; set; }",
    "",
    "        [Description(\"Inizio finestra irrigua (d-mmm)\")]",
    "        public string WindowStart { get; set; }",
    "",
    "        [Description(\"Fine finestra irrigua (d-mmm)\")]",
    "        public string WindowEnd { get; set; }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (!Maize.IsAlive) return;",
    "            if (!DateUtilities.WithinDates(WindowStart, Clock.Today, WindowEnd)) return;",
    "",
    "            // Calcola PAW e PAWC dal profilo suolo corrente",
    "            var physical = Zone.FindDescendant<IPhysical>();",
    "            var soilWater = Zone.FindDescendant<ISoilWater>();",
    "            if (physical == null || soilWater == null) return;",
    "",
    "            double[] sw        = soilWater.SW;         // vol. water content",
    "            double[] thickness = soilWater.Thickness;   // ISoilWater espone Thickness",
    "            double[] dul       = physical.DUL;          // IPhysical espone DUL e LL15",
    "            double[] ll15      = physical.LL15;",
    "",
    "            double pawc = 0, paw = 0;",
    "            int nLayers = Math.Min(sw.Length, Math.Min(dul.Length, Math.Min(ll15.Length, thickness.Length)));",
    "            for (int i = 0; i < nLayers; i++)",
    "            {",
    "                double lPawc = thickness[i] * Math.Max(0, dul[i] - ll15[i]);",
    "                double lPaw  = thickness[i] * Math.Max(0, Math.Min(sw[i], dul[i]) - ll15[i]);",
    "                pawc += lPawc;",
    "                paw  += lPaw;",
    "            }",
    "",
    "            if (pawc <= 0) return;",
    "            double fraction = paw / pawc;",
    "",
    "            if (fraction < Threshold)",
    "            {",
    "                double deficit = (Target - fraction) * pawc;",
    "                double amount  = Math.Min(Math.Max(0, deficit), MaxMm);",
    "                if (amount >= 1.0)",
    "                {",
    "                    Irrigation.Apply(amount);",
    "                    Summary.WriteMessage(this, $\"Irrigazione Maize: {amount:F1} mm (PAW {fraction:P0} → target {Target:P0})\", MessageType.Diagnostic);",
    "                }",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
    {
      "Key": "Threshold",
      "Value": "0.50"
    },
    {
      "Key": "Target",
      "Value": "0.85"
    },
    {
      "Key": "MaxMm",
      "Value": "35.0"
    },
    {
      "Key": "WindowStart",
      "Value": "1-jun"
    },
    {
      "Key": "WindowEnd",
      "Value": "31-aug"
    }
  ],
  "Children": []
},
            {
  "$type": "Models.PMF.Plant, Models",
  "Name": "Soybean",
  "ResourceName": "Soybean",
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Sow_Soybean",
  "CodeArray": [
    "using APSIM.Shared.Utilities;",
    "using Models.PMF;",
    "using Models.Core;",
    "using System;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Summary Summary;",
    "        [Link(ByName = true)] private Plant Soybean;",
    "",
    "        [Description(\"Start of sowing window (d-mmm)\")]",
    "        public string StartDate { get; set; }",
    "",
    "        [Description(\"End of sowing window (d-mmm)\")]",
    "        public string EndDate { get; set; }",
    "",
    "        [Description(\"Cultivar name\")]",
    "        public string CultivarName { get; set; }",
    "",
    "        [Description(\"Sowing depth (mm)\")]",
    "        public double SowingDepth { get; set; }",
    "",
    "        [Description(\"Row spacing (mm)\")]",
    "        public double RowSpacing { get; set; }",
    "",
    "        [Description(\"Sowing population (/m2)\")]",
    "        public double Population { get; set; }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (DateUtilities.WithinDates(StartDate, Clock.Today, EndDate) && !Soybean.IsAlive)",
    "            {",
    "                Summary.WriteMessage(this, $\"Sowing Soybean on {Clock.Today:dd-MMM-yyyy} cultivar={CultivarName} pop={Population}\", MessageType.Diagnostic);",
    "                Soybean.Sow(cultivar: CultivarName, population: Population,",
    "                         depth: SowingDepth, rowSpacing: RowSpacing);",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
    {
      "Key": "StartDate",
      "Value": "1-may"
    },
    {
      "Key": "EndDate",
      "Value": "15-jun"
    },
    {
      "Key": "CultivarName",
      "Value": "Generic_MG1"
    },
    {
      "Key": "SowingDepth",
      "Value": "35"
    },
    {
      "Key": "RowSpacing",
      "Value": "450"
    },
    {
      "Key": "Population",
      "Value": "35.0"
    }
  ],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Harvest_Soybean",
  "CodeArray": [
    "using Models.Soils;",
    "using System;",
    "using System.Linq;",
    "using Models.Core;",
    "using Models.PMF;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link]",
    "        private Clock clock;",
    "",
    "        [Link]",
    "        private IPlant crop;",
    "",
    "        [EventSubscribe(\"EndOfDay\")]",
    "        private void OnDoCalculations(object sender, EventArgs e)",
    "        {",
    "            if (crop.IsReadyForHarvesting)",
    "            {",
    "                crop.Harvest();",
    "                crop.EndCrop();",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Irrigate_Soybean",
  "CodeArray": [
    "using Models.Core;",
    "using Models.Soils;",
    "using Models.Interfaces;",
    "using System;",
    "using System.Linq;",
    "using APSIM.Shared.Utilities;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Irrigation Irrigation;",
    "        [Link] private Summary Summary;",
    "        [Link] private Zone Zone;",
    "        [Link(ByName = true)] private Models.PMF.Plant Soybean;",
    "",
    "        [Description(\"Soglia PAW/PAWC sotto cui irrigare (0-1)\")]",
    "        public double Threshold { get; set; }",
    "",
    "        [Description(\"Obiettivo di ricarica PAW/PAWC (0-1)\")]",
    "        public double Target { get; set; }",
    "",
    "        [Description(\"Dose massima per turno (mm)\")]",
    "        public double MaxMm { get; set; }",
    "",
    "        [Description(\"Inizio finestra irrigua (d-mmm)\")]",
    "        public string WindowStart { get; set; }",
    "",
    "        [Description(\"Fine finestra irrigua (d-mmm)\")]",
    "        public string WindowEnd { get; set; }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (!Soybean.IsAlive) return;",
    "            if (!DateUtilities.WithinDates(WindowStart, Clock.Today, WindowEnd)) return;",
    "",
    "            // Calcola PAW e PAWC dal profilo suolo corrente",
    "            var physical = Zone.FindDescendant<IPhysical>();",
    "            var soilWater = Zone.FindDescendant<ISoilWater>();",
    "            if (physical == null || soilWater == null) return;",
    "",
    "            double[] sw        = soilWater.SW;         // vol. water content",
    "            double[] thickness = soilWater.Thickness;   // ISoilWater espone Thickness",
    "            double[] dul       = physical.DUL;          // IPhysical espone DUL e LL15",
    "            double[] ll15      = physical.LL15;",
    "",
    "            double pawc = 0, paw = 0;",
    "            int nLayers = Math.Min(sw.Length, Math.Min(dul.Length, Math.Min(ll15.Length, thickness.Length)));",
    "            for (int i = 0; i < nLayers; i++)",
    "            {",
    "                double lPawc = thickness[i] * Math.Max(0, dul[i] - ll15[i]);",
    "                double lPaw  = thickness[i] * Math.Max(0, Math.Min(sw[i], dul[i]) - ll15[i]);",
    "                pawc += lPawc;",
    "                paw  += lPaw;",
    "            }",
    "",
    "            if (pawc <= 0) return;",
    "            double fraction = paw / pawc;",
    "",
    "            if (fraction < Threshold)",
    "            {",
    "                double deficit = (Target - fraction) * pawc;",
    "                double amount  = Math.Min(Math.Max(0, deficit), MaxMm);",
    "                if (amount >= 1.0)",
    "                {",
    "                    Irrigation.Apply(amount);",
    "                    Summary.WriteMessage(this, $\"Irrigazione Soybean: {amount:F1} mm (PAW {fraction:P0} → target {Target:P0})\", MessageType.Diagnostic);",
    "                }",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
