            {
  "$type": "Models.Manager, Models",
  "Name": "Sow_Wheat",
  "CodeArray": [
    "using APSIM.Shared.Utilities;",
    "using Models.PMF;",
    "using Models.Core;",
    "using System;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Summary Summary;",
    "        [Link(ByName = true)] private Plant Wheat;",
    "",
    "        [Description(\"Start of sowing window (d-mmm)\")]",
    "        public string StartDate { get; set; }",
    "",
    "        [Description(\"End of sowing window (d-mmm)\")]",
    "        public string EndDate { get; set; }",
    "",
    "        [Description(\"Cultivar name\")]",
    "        public string CultivarName { get; set; }",
    "",
    "        [Description(\"Sowing depth (mm)\")]",
    "        public double SowingDepth { get; set; }",
    "",
    "        [Description(\"Row spacing (mm)\")]",
    "        public double RowSpacing { get; set; }",
    "",
    "        [Description(\"Sowing population (/m2)\")]",
    "        public double Population { get; set; }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (DateUtilities.WithinDates(StartDate, Clock.Today, EndDate) && !Wheat.IsAlive)",
    "            {",
    "                Summary.WriteMessage(this, $\"Sowing Wheat on {Clock.Today:dd-MMM-yyyy} cultivar={CultivarName} pop={Population}\", MessageType.Diagnostic);",
    "                Wheat.Sow(cultivar: CultivarName, population: Population,",
    "                         depth: SowingDepth, rowSpacing: RowSpacing);",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
    {
      "Key": "StartDate",
      "Value": "10-oct"
    },
    {
      "Key": "EndDate",
      "Value": "20-nov"
    },
    {
      "Key": "CultivarName",
      "Value": "Hartog"
    },
    {
      "Key": "SowingDepth",
      "Value": "35"
    },
    {
      "Key": "RowSpacing",
      "Value": "180"
    },
    {
      "Key": "Population",
      "Value": "180.0"
    }
  ],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Harvest_Wheat",
  "CodeArray": [
    "using Models.Soils;",
    "using System;",
    "using System.Linq;",
    "using Models.Core;",
    "using Models.PMF;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link]",
    "        private Clock clock;",
    "",
    "        [Link]",
    "        private IPlant crop;",
    "",
    "        [EventSubscribe(\"EndOfDay\")]",
    "        private void OnDoCalculations(object sender, EventArgs e)",
    "        {",
    "            if (crop.IsReadyForHarvesting)",
    "            {",
    "                crop.Harvest();",
    "                crop.EndCrop();",
    "            }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
  "Name": "Fertilise_Wheat_D100_1",
  "CodeArray": [
    "using Models.Core;",
    "using System;",
    "",
    "namespace Models",
    "{",
    "    [Serializable]",
    "    public class Script : Model",
    "    {",
    "        [Link] private Clock Clock;",
    "        [Link] private Fertiliser Fertiliser;",
    "        [Link] private Summary Summary;",
    "        [Link(ByName = true)] private Models.PMF.Plant Wheat;",
    "",
    "        [Description(\"Days after sowing\")]",
    "        public int DAS { get; set; }",
    "",
    "        [Description(\"Amount of N (kg/ha)\")]",
    "        public double Amount { get; set; }",
    "",
    "        [Description(\"Fertiliser type\")]",
    "        public string FertType { get; set; }",
    "",
    "        private DateTime _sowDate = DateTime.MinValue;",
    "        private bool _applied = false;",
    "",
    "        [EventSubscribe(\"Sowing\")]",
    "        private void OnSowing(object sender, EventArgs e)",
    "        {",
    "            if (sender == Wheat)",
    "            {",
    "                _sowDate = Clock.Today;",
    "                _applied = false;",
    "            }",
    "        }",
    "",
    "        [EventSubscribe(\"DoManagement\")]",
    "        private void OnDoManagement(object sender, EventArgs e)",
    "        {",
    "            if (!_applied && _sowDate != DateTime.MinValue && Wheat.IsAlive)",
    "            {",
    "                int das = (Clock.Today - _sowDate).Days;",
    "                if (das >= DAS && Amount > 0)",
    "                {",
    "                    Fertiliser.Apply(amount: Amount, type: FertType);",
    "                    Summary.WriteMessage(this, $\"N copertura Wheat: {Amount:F1} kg N/ha a {das} DAS\", MessageType.Diagnostic);",
    "                    _applied = true;",
    "                }",
    "            }",
    "            // Reset quando la coltura è morta/raccolta",
    "            if (!Wheat.IsAlive) { _sowDate = DateTime.MinValue; _applied = false; }",
    "        }",
    "    }",
    "}"
  ],
  "Parameters": [
    {
      "Key": "DAS",
      "Value": "100"
    },
    {
      "Key": "Amount",
      "Value": "65.0"
    },
    {
      "Key": "FertType",
      "Value": "UreaN"
    }
  ],
  "Children": []
},
            {
  "$type": "Models.Manager, Models",
